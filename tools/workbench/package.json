{
  "name": "rdf4j-workbench-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Front end of the RDF4J Workbench: the classic lit-html pages (scripts/ts) and the React graph explorer (src/main/frontend).",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:classic && npm run build:explorer",
    "build:classic": "tsc -p tsconfig.classic.json",
    "build:explorer": "vite build",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test \"src/test/frontend/**/*.test.mjs\"",
    "fixtures:queries": "node --experimental-strip-types scripts/export-query-fixtures.mjs"
  },
  "dependencies": {
    "@viz-js/viz": "3.31.0",
    "cytoscape": "3.34.4",
    "cytoscape-fcose": "2.2.0",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "webcola": "3.4.0"
  },
  "devDependencies": {
    "@types/codemirror": "5.60.18",
    "@types/jquery": "3.5.34",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
