SELECT DISTINCT ?property WHERE {
 { VALUES ?property { <urn:ex:relation> <urn:ex:labelCode> } VALUES ?known { <http://www.w3.org/2004/02/skos/core#prefLabel> <http://www.w3.org/2000/01/rdf-schema#label> <https://schema.org/name> <http://schema.org/name> <http://purl.org/dc/terms/title> <http://purl.org/dc/elements/1.1/title> <http://xmlns.com/foaf/0.1/name> <http://www.w3.org/2006/vcard/ns#fn> <http://www.w3.org/2001/vcard-rdf/3.0#FN> <http://www.geonames.org/ontology#name> <https://www.omg.org/spec/Commons/TextDatatype/hasName> <http://www.w3.org/2004/02/skos/core#altLabel> <https://schema.org/alternateName> <http://schema.org/alternateName> <http://purl.org/dc/terms/alternative> <http://purl.obolibrary.org/obo/IAO_0000111> <http://purl.obolibrary.org/obo/IAO_0000118> }
?property (<http://www.w3.org/2000/01/rdf-schema#subPropertyOf>|<http://www.w3.org/2002/07/owl#equivalentProperty>|^<http://www.w3.org/2002/07/owl#equivalentProperty>)+ ?known . } UNION { GRAPH ?__graph { VALUES ?property { <urn:ex:relation> <urn:ex:labelCode> } VALUES ?known { <http://www.w3.org/2004/02/skos/core#prefLabel> <http://www.w3.org/2000/01/rdf-schema#label> <https://schema.org/name> <http://schema.org/name> <http://purl.org/dc/terms/title> <http://purl.org/dc/elements/1.1/title> <http://xmlns.com/foaf/0.1/name> <http://www.w3.org/2006/vcard/ns#fn> <http://www.w3.org/2001/vcard-rdf/3.0#FN> <http://www.geonames.org/ontology#name> <https://www.omg.org/spec/Commons/TextDatatype/hasName> <http://www.w3.org/2004/02/skos/core#altLabel> <https://schema.org/alternateName> <http://schema.org/alternateName> <http://purl.org/dc/terms/alternative> <http://purl.obolibrary.org/obo/IAO_0000111> <http://purl.obolibrary.org/obo/IAO_0000118> }
?property (<http://www.w3.org/2000/01/rdf-schema#subPropertyOf>|<http://www.w3.org/2002/07/owl#equivalentProperty>|^<http://www.w3.org/2002/07/owl#equivalentProperty>)+ ?known . } }
} LIMIT 2
