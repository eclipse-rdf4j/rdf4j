SELECT DISTINCT ?resource ?labelProperty ?label WHERE {
 { { VALUES ?resource { <urn:ex:one> <urn:ex:two> <urn:ex:three> } VALUES ?labelProperty { <http://www.w3.org/2004/02/skos/core#prefLabel> <http://www.w3.org/2000/01/rdf-schema#label> <https://schema.org/name> <http://schema.org/name> <http://purl.org/dc/terms/title> <http://purl.org/dc/elements/1.1/title> <http://xmlns.com/foaf/0.1/name> <http://www.w3.org/2006/vcard/ns#fn> <http://www.w3.org/2001/vcard-rdf/3.0#FN> <http://www.geonames.org/ontology#name> <https://www.omg.org/spec/Commons/TextDatatype/hasName> <http://www.w3.org/2004/02/skos/core#altLabel> <https://schema.org/alternateName> <http://schema.org/alternateName> <http://purl.org/dc/terms/alternative> <http://purl.obolibrary.org/obo/IAO_0000111> <http://purl.obolibrary.org/obo/IAO_0000118> } ?resource ?labelProperty ?label . } UNION { GRAPH ?__graph { VALUES ?resource { <urn:ex:one> <urn:ex:two> <urn:ex:three> } VALUES ?labelProperty { <http://www.w3.org/2004/02/skos/core#prefLabel> <http://www.w3.org/2000/01/rdf-schema#label> <https://schema.org/name> <http://schema.org/name> <http://purl.org/dc/terms/title> <http://purl.org/dc/elements/1.1/title> <http://xmlns.com/foaf/0.1/name> <http://www.w3.org/2006/vcard/ns#fn> <http://www.w3.org/2001/vcard-rdf/3.0#FN> <http://www.geonames.org/ontology#name> <https://www.omg.org/spec/Commons/TextDatatype/hasName> <http://www.w3.org/2004/02/skos/core#altLabel> <https://schema.org/alternateName> <http://schema.org/alternateName> <http://purl.org/dc/terms/alternative> <http://purl.obolibrary.org/obo/IAO_0000111> <http://purl.obolibrary.org/obo/IAO_0000118> } ?resource ?labelProperty ?label . } } } UNION { { VALUES ?resource { <urn:ex:one> <urn:ex:two> <urn:ex:three> } VALUES ?labelProperty { <http://www.w3.org/2008/05/skos-xl#prefLabel> <http://www.w3.org/2008/05/skos-xl#altLabel> } ?resource ?labelProperty ?labelNode . ?labelNode <http://www.w3.org/2008/05/skos-xl#literalForm> ?label . } UNION { GRAPH ?__labelGraph { VALUES ?resource { <urn:ex:one> <urn:ex:two> <urn:ex:three> } VALUES ?labelProperty { <http://www.w3.org/2008/05/skos-xl#prefLabel> <http://www.w3.org/2008/05/skos-xl#altLabel> } ?resource ?labelProperty ?labelNode . ?labelNode <http://www.w3.org/2008/05/skos-xl#literalForm> ?label . } } }
 FILTER(isLiteral(?label) && STRLEN(STR(?label)) > 0 && STRLEN(STR(?label)) <= 512)
} LIMIT 4096
