SELECT ?s ?p ?o WHERE { {
 SELECT DISTINCT ?s ?p ?o WHERE {
 GRAPH <urn:ex:graph> { VALUES ?s { <urn:ex:named> } ?s ?p ?o . } FILTER(!isTRIPLE(?o))
 } LIMIT 101
 } UNION {
 SELECT DISTINCT ?s ?p ?o WHERE {
 GRAPH <urn:ex:graph> { VALUES ?s { <urn:ex:one> } ?s ?p ?o . } FILTER(!isTRIPLE(?o))
 } LIMIT 101
 } }
