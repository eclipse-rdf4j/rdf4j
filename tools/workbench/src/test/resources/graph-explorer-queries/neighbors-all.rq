SELECT ?selected ?source ?predicate ?target WHERE { {
 SELECT DISTINCT ?selected ?source ?predicate ?target WHERE {
 { VALUES ?__anchor { <urn:ex:one> }
BIND(?__anchor AS ?selected) BIND(?selected AS ?source) ?source <urn:ex:relation> ?target . } UNION { GRAPH ?__graph { VALUES ?__anchor { <urn:ex:one> }
BIND(?__anchor AS ?selected) BIND(?selected AS ?source) ?source <urn:ex:relation> ?target . } }
 BIND(<urn:ex:relation> AS ?predicate)
 } LIMIT 2
 } UNION {
 SELECT DISTINCT ?selected ?source ?predicate ?target WHERE {
 { VALUES ?__anchor { <urn:ex:two> }
BIND(?__anchor AS ?selected) BIND(?selected AS ?source) ?source <urn:ex:relation> ?target . } UNION { GRAPH ?__graph { VALUES ?__anchor { <urn:ex:two> }
BIND(?__anchor AS ?selected) BIND(?selected AS ?source) ?source <urn:ex:relation> ?target . } }
 BIND(<urn:ex:relation> AS ?predicate)
 } LIMIT 2
 } }
