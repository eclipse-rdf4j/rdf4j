SELECT ?selected ?links WHERE { {
 SELECT ?selected (COUNT(*) AS ?links) WHERE { {
 SELECT DISTINCT ?selected ?source ?target WHERE {
 VALUES ?__anchor { <urn:ex:one> }
BIND(?__anchor AS ?selected) BIND(?selected AS ?source) ?source <urn:ex:relation> ?target .
 } LIMIT 1001
 } } GROUP BY ?selected
 } UNION {
 SELECT ?selected (COUNT(*) AS ?links) WHERE { {
 SELECT DISTINCT ?selected ?source ?target WHERE {
 VALUES ?__anchor { <urn:ex:two> }
BIND(?__anchor AS ?selected) BIND(?selected AS ?source) ?source <urn:ex:relation> ?target .
 } LIMIT 1001
 } } GROUP BY ?selected
 } UNION {
 SELECT ?selected (COUNT(*) AS ?links) WHERE { {
 SELECT DISTINCT ?selected ?source ?target WHERE {
 VALUES ?__anchor { <urn:ex:Thing> }
BIND(?__anchor AS ?selected) BIND(?selected AS ?source) ?source <urn:ex:relation> ?target .
 } LIMIT 1001
 } } GROUP BY ?selected
 } }
