SELECT DISTINCT ?s WHERE {
 VALUES ?s { <urn:ex:hub> <urn:ex:one> } ?s <urn:ex:size> ?o . FILTER(isLiteral(?o) && REGEX(REPLACE(STR(?o), "^[\\s\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+|[\\s\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+$", ""), "^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?$") && ABS(<http://www.w3.org/2001/XMLSchema#double>(REPLACE(STR(?o), "^[\\s\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+|[\\s\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+$", ""))) <= 1.7976931348623157e308 && <http://www.w3.org/2001/XMLSchema#double>(REPLACE(STR(?o), "^[\\s\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+|[\\s\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+$", "")) >= "40"^^<http://www.w3.org/2001/XMLSchema#double> && <http://www.w3.org/2001/XMLSchema#double>(REPLACE(STR(?o), "^[\\s\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+|[\\s\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]+$", "")) <= "50"^^<http://www.w3.org/2001/XMLSchema#double>)
}
