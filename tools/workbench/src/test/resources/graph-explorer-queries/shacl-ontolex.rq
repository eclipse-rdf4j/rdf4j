SELECT DISTINCT ?resource ?labelProperty ?label WHERE {
 VALUES ?resource { <urn:ex:shapedPredicate> <urn:ex:lexicalEntry> }
 { VALUES ?labelProperty { <http://www.w3.org/2004/02/skos/core#prefLabel> <http://www.w3.org/2000/01/rdf-schema#label> <https://schema.org/name> <http://schema.org/name> <http://purl.org/dc/terms/title> <http://purl.org/dc/elements/1.1/title> <http://xmlns.com/foaf/0.1/name> <http://www.w3.org/2006/vcard/ns#fn> <http://www.w3.org/2001/vcard-rdf/3.0#FN> <http://www.geonames.org/ontology#name> <https://www.omg.org/spec/Commons/TextDatatype/hasName> <http://www.w3.org/2004/02/skos/core#altLabel> <https://schema.org/alternateName> <http://schema.org/alternateName> <http://purl.org/dc/terms/alternative> <http://purl.obolibrary.org/obo/IAO_0000111> <http://purl.obolibrary.org/obo/IAO_0000118> }
?resource ?labelProperty ?label . } UNION { VALUES ?labelProperty { <http://www.w3.org/2008/05/skos-xl#prefLabel> <http://www.w3.org/2008/05/skos-xl#altLabel> } ?resource ?labelProperty ?labelNode . ?labelNode <http://www.w3.org/2008/05/skos-xl#literalForm> ?label . } UNION { ?shape <http://www.w3.org/ns/shacl#path> ?resource . ?shape <http://www.w3.org/ns/shacl#name> ?label . BIND(<http://www.w3.org/ns/shacl#name> AS ?labelProperty) } UNION { ?resource <http://www.w3.org/ns/lemon/ontolex#canonicalForm> ?form . ?form <http://www.w3.org/ns/lemon/ontolex#writtenRep> ?label . BIND(<http://www.w3.org/ns/lemon/ontolex#canonicalForm> AS ?labelProperty) }
 FILTER(isLiteral(?label) && STRLEN(STR(?label)) > 0 && STRLEN(STR(?label)) <= 512)
} LIMIT 4096
