SELECT ?selected ?source ?predicate ?target WHERE { {
 SELECT DISTINCT ?selected ?source ?predicate ?target WHERE {
 VALUES ?__anchor { <urn:ex:one> }
BIND(?__anchor AS ?selected) BIND(?selected AS ?source) ?source ?predicate ?target .
 MINUS { VALUES (?predicate ?target) { (<urn:ex:relation> <urn:ex:two>) } }
 } LIMIT 2 OFFSET 2
 } UNION {
 SELECT DISTINCT ?selected ?source ?predicate ?target WHERE {
 VALUES ?__anchor { <urn:ex:one> }
BIND(?__anchor AS ?selected) BIND(?selected AS ?target) ?source ?predicate ?target .
 
 } LIMIT 2 OFFSET 2
 } }
