PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dataset: <http://data.gov.be/dataset/biodiv/>

SELECT ?catalog ?p ?q ?distribution
WHERE {
  ?catalog ?p dataset:230363a1-8221-4f53-b1fc-e8475ac247aa .
  dataset:230363a1-8221-4f53-b1fc-e8475ac247aa ?q ?distribution .
  ?distribution a dcat:Distribution .
}
