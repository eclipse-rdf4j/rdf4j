PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT ?q ?dataset ?p ?left ?right ?leftFormat ?rightFormat
WHERE {
  <http://data.gov.be/catalog> ?q ?dataset .
  ?dataset a dcat:Dataset ;
    ?p ?left, ?right .
  ?left dct:format ?leftFormat .
  ?right dct:format ?rightFormat .
  FILTER(!sameTerm(?left, ?right))
}
LIMIT 10
