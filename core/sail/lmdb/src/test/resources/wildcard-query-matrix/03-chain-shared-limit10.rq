PREFIX dataset: <http://data.gov.be/dataset/biodiv/>

SELECT ?p ?shared ?peer ?other
WHERE {
  dataset:230363a1-8221-4f53-b1fc-e8475ac247aa ?p ?shared .
  ?peer ?p ?shared, ?other .
  FILTER(!sameTerm(dataset:230363a1-8221-4f53-b1fc-e8475ac247aa, ?peer)
    && isIRI(?shared) && isIRI(?other) && !sameTerm(?shared, ?other))
}
LIMIT 10
