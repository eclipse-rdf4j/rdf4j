+#!/usr/bin/env python3
+# Copyright (c) 2026 Eclipse RDF4J contributors.
+# SPDX-License-Identifier: BSD-3-Clause
+# Some portions generated by Codex
+"""Check historical CSV compatibility, dimension separation and paired automatic comparisons."""
+
+import csv
+import importlib.util
+import tempfile
+import unittest
+from pathlib import Path
+
+
+SPEC = importlib.util.spec_from_file_location(
+    "sparse_summary", Path(__file__).with_name("summarize-sparse-join-aggregate.py"))
+SUMMARY = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(SUMMARY)
+
+
+def sample(route, milliseconds, fork=0, phase="warm", **dimensions):
+    row = dict(endpoints="64", join_keys="128", fanout="8", blocks="1", multiplicity="1",
+               having="none", threshold="0", count_expression="bound", strategy=route,
+               fork=str(fork), phase=phase, total_ns=str(int(milliseconds * 1_000_000)),
+               output_density="0.25", nonzero_groups="1024", retained_groups="1024",
+               actual_paths=route, sparse_work="leftRows=64,rightEndpoints=64")
+    row.update(dimensions)
+    return row
+
+
+def write_samples(directory, rows):
+    fieldnames = list(dict.fromkeys(key for row in rows for key in row))
+    forks = sorted({row["fork"] for row in rows})
+    for fork in forks:
+        with (directory / f"fork-{fork}.csv").open("w", newline="", encoding="utf-8") as output:
+            writer = csv.DictWriter(output, fieldnames=fieldnames)
+            writer.writeheader()
+            writer.writerows(row for row in rows if row["fork"] == fork)
+
+
+def read_csv(path):
+    with path.open(newline="", encoding="utf-8") as source:
+        return list(csv.DictReader(source))
+
+
+class SparseSummaryTest(unittest.TestCase):
+    def test_historical_csv_keeps_symmetric_dimensions_and_paired_sparse_ratios(self):
+        rows = []
+        for fork in range(2):
+            for route, milliseconds in (("auto", 20 + fork * 20),
+                                        ("packedFtreeAggregate", 30), ("sparseJoinAggregate", 10)):
+                for phase in ("first", "warm"):
+                    rows.append(sample(route, milliseconds, fork, phase))
+        with tempfile.TemporaryDirectory() as name:
+            directory = Path(name)
+            write_samples(directory, rows)
+            SUMMARY.summarize(directory)
+            summary = read_csv(directory / "summary.csv")
+            self.assertEqual(3, len(summary))
+            auto = next(row for row in summary if row["strategy"] == "auto")
+            self.assertEqual(("8", "8", "uniform", "100", "false", "legacy_false"),
+                             tuple(auto[key] for key in ("left_fanout", "right_fanout", "distribution",
+                                                       "overlap", "parallel", "sparse_setting")))
+            comparison = next(row for row in read_csv(directory / "comparison.csv")
+                              if row["baseline"] == "auto")
+            self.assertEqual(3.0, float(comparison["median_paired_speedup"]))
+            self.assertEqual(10.0, float(comparison["sparse_median_ms"]))
+            self.assertEqual("64", auto["observed_streamed_endpoints"])
+            self.assertEqual("64", auto["observed_retained_endpoints"])
+            self.assertEqual("", auto["sparse_plan_witnesses"])
+            self.assertFalse((directory / "automatic-comparison.csv").exists())
+
+    def test_new_dimensions_do_not_merge_and_witnesses_do_not_become_samples(self):
+        rows = []
+        dimensions = (("1", "32", "uniform", "100", "false"), ("32", "1", "uniform", "100", "false"),
+                      ("1", "32", "hot", "100", "false"), ("1", "32", "uniform", "25", "false"),
+                      ("1", "32", "uniform", "100", "true"))
+        for left, right, distribution, overlap, parallel in dimensions:
+            for fork in range(2):
+                for route, milliseconds in (("autoDisabled", 20), ("auto", 10), ("sparseJoinAggregate", 8)):
+                    setting = "default" if route == "auto" else str(route == "sparseJoinAggregate").lower()
+                    for phase in ("first", "warm", "witness"):
+                        rows.append(sample(route, 0 if phase == "witness" else milliseconds, fork, phase,
+                                           fanout=left, left_fanout=left, right_fanout=right,
+                                           distribution=distribution, overlap=overlap, parallel=parallel,
+                                           sparse_setting=setting,
+                                           route_witness_scope="separate_executed_explanation",
+                                           route_witness_stage="after_warm_samples" if phase == "witness"
+                                           else "before_warm_samples",
+                                           actual_paths="sparseJoinAggregate" if phase == "witness"
+                                           else "packedFtreeAggregate"))
+        with tempfile.TemporaryDirectory() as name:
+            directory = Path(name)
+            write_samples(directory, rows)
+            SUMMARY.summarize(directory)
+            automatic = read_csv(directory / "automatic-comparison.csv")
+            self.assertEqual(5, len(automatic))
+            self.assertTrue(all(float(row["median_paired_speedup"]) == 2.0 for row in automatic))
+            self.assertTrue(all(row["baseline"] == "autoDisabled" and row["candidate"] == "auto"
+                                for row in automatic))
+            summary = read_csv(directory / "summary.csv")
+            self.assertEqual(15, len(summary))
+            self.assertTrue(all(row["samples"] == "2" for row in summary))
+            self.assertTrue(all(row["route_witnesses"] == "packedFtreeAggregate | sparseJoinAggregate"
+                                for row in summary))
+            self.assertEqual(10, len(read_csv(directory / "comparison.csv")))
+
+    def test_transposed_witnesses_preserve_roles_and_orientation_independent_density(self):
+        rows = []
+        plans = ("streamBinding=x,retainedBinding=y", "streamBinding=y,retainedBinding=x")
+        for fork, (streamed, retained) in enumerate(((16, 64), (64, 16))):
+            for route in ("autoDisabled", "auto", "sparseJoinAggregate"):
+                for phase in ("first", "warm"):
+                    rows.append(sample(route, 10, fork, phase,
+                                       sparse_plan="" if route == "autoDisabled" else plans[fork],
+                                       sparse_work=f"leftRows={streamed},rightEndpoints={retained}"))
+        with tempfile.TemporaryDirectory() as name:
+            directory = Path(name)
+            write_samples(directory, rows)
+            SUMMARY.summarize(directory)
+            summary = read_csv(directory / "summary.csv")
+            for row in summary:
+                self.assertEqual("", row["observed_streamed_endpoints"])
+                self.assertEqual("", row["observed_retained_endpoints"])
+                self.assertEqual("16x64 | 64x16", row["observed_endpoint_dimension_witnesses"])
+                self.assertEqual("sparseJoinAggregate", row["dimension_reference_route"])
+                self.assertEqual(1.0, float(row["observed_output_density"]))
+            sparse = next(row for row in summary if row["strategy"] == "sparseJoinAggregate")
+            self.assertEqual(" | ".join(plans), sparse["sparse_plan_witnesses"])
+            automatic = read_csv(directory / "automatic-comparison.csv")[0]
+            self.assertEqual(" | ".join(plans), automatic["candidate_sparse_plan_witnesses"])
+
+    def test_unpaired_automatic_forks_are_rejected(self):
+        rows = []
+        for fork, route in ((0, "autoDisabled"), (0, "auto"), (1, "autoDisabled")):
+            for phase in ("first", "warm"):
+                rows.append(sample(route, 10, fork, phase))
+        with tempfile.TemporaryDirectory() as name:
+            directory = Path(name)
+            write_samples(directory, rows)
+            with self.assertRaisesRegex(ValueError, "Unpaired forks.*autoDisabled versus auto"):
+                SUMMARY.summarize(directory)
+
+
+if __name__ == "__main__":
+    unittest.main()
