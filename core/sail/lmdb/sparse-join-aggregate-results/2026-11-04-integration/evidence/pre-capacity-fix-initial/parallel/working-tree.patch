+				Fixture named = new Fixture(4096L, 4096L, 64L, 64L, 64L, 64L, null, true, null, false)) {
+			assertNotEquals(unrestricted.plan.properties(), scoped.plan.properties());
+			assertNotEquals(unrestricted.plan.properties(), named.plan.properties());
+			assertNotEquals(scoped.plan.properties(), named.plan.properties());
+			assertTrue(unrestricted.plan.properties().contains("contextBuffers=0"));
+		}
+	}
+
+	@Test
+	void anUnpriceableProducerHasNoColdAnchor() {
+		try (Fixture fixture = new Fixture(4096L, 4096L, 64L, 64L, 64L, 64L, false)) {
+			assertNull(fixture.plan.coldAnchor(fixture.row, null));
+		}
+	}
+
+	@Test
+	void preparationRetainsTheSmallerPlaneAndReusesItsSnapshotQuote() {
+		try (Fixture fixture = new Fixture(32L, 4096L, 8L, 4L, 4L, 1024L, false)) {
+			LmdbSparseJoinAggregatePlan prepared = fixture.plan.prepare(fixture.row);
+			assertNotNull(prepared);
+			assertTrue(prepared.properties().contains("retainedSlot=0"),
+					"the original left plane has the smaller dictionaries, fibers and endpoint accumulator");
+			NativeAggregatePhysicalPlan.Work work = prepared.quote(fixture.row);
+			assertNotNull(work);
+			assertEquals(44D, work.retainedRows());
+			when(fixture.source.exactPredicateCount(20L)).thenReturn(OptionalLong.empty());
+			assertEquals(work, prepared.quote(fixture.row),
+					"one offered recipe must keep its own captured physical metadata");
+			verify(fixture.source, never()).newProbe();
+		}
+	}
+
+	@Test
+	void equalStateBoundsPreserveTheOriginalOrientation() {
+		try (Fixture fixture = new Fixture(4096L, 4096L, 64L, 64L, 64L, 64L, false)) {
+			assertTrue(fixture.plan.prepare(fixture.row).properties().contains("retainedSlot=2"));
+		}
+	}
+
+	@Test
+	void aStateBoundBeyondTheQueryCapCannotBeAColdAnchor() {
+		LmdbQueryMemoryManager previous = LmdbNativeHashJoin.queryMemoryOverride;
+		LmdbNativeHashJoin.queryMemoryOverride = LmdbQueryMemoryManager.createForTesting(1024L, 1024L);
+		try (Fixture fixture = new Fixture(4096L, 4096L, 64L, 64L, 64L, 64L, false)) {
+			NativeAggregatePhysicalPlan.Work work = fixture.plan.quote(fixture.row);
+			assertNotNull(work, "a memory refusal does not turn bounded operation counts into unknown work");
+			assertNull(fixture.plan.coldAnchor(fixture.row, work));
+		} finally {
+			LmdbNativeHashJoin.queryMemoryOverride = previous;
+		}
+	}
+
+	@Test
+	void veryLargeMetadataKeepsFiniteWorkAndDeclinesUnrepresentableState() {
+		try (Fixture fixture = new Fixture(Long.MAX_VALUE, Long.MAX_VALUE, 1_000_000_000L, 1_000_000_000L,
+				1_000_000_000L, 1_000_000_000L, false)) {
+			NativeAggregatePhysicalPlan.Work work = fixture.plan.quote(fixture.row);
+			assertNotNull(work);
+			LmdbNativeCostVector operations = work.input().operations().plus(work.extra());
+			for (LmdbNativeCostVector.Feature feature : LmdbNativeCostVector.Feature.values()) {
+				assertTrue(Double.isFinite(operations.high(feature)), () -> "nonfinite quote for " + feature);
+			}
+			assertNull(fixture.plan.coldAnchor(fixture.row, work));
+		}
+	}
+
+	@Test
+	void emptyPlaneHasNoProductOrOutputWork() {
+		try (Fixture fixture = new Fixture(0L, 4096L, 0L, 0L, 64L, 64L, false)) {
+			NativeAggregatePhysicalPlan.Work work = fixture.plan.quote(fixture.row);
+			assertNotNull(work);
+			assertEquals(0D, work.input().highRows());
+			assertEquals(0D, work.extra().high(GROUP_UPDATE));
+			assertNull(fixture.plan.coldAnchor(fixture.row, work));
+		}
+	}
+
+	private static final class Fixture implements AutoCloseable {
+		final NativeLmdbQuerySource source = mock(NativeLmdbQuerySource.class);
+		final RowState row;
+		final LmdbSparseJoinAggregatePlan plan;
+		final NativeSlotLayout layout;
+		final SlotPlan input;
+		final AggregateSpec[] aggregates;
+		final NativeGroupIteration iteration;
+
+		Fixture(long leftCount, long rightCount, long leftEndpoints, long leftShared, long rightShared,
+				long rightEndpoints, boolean scoped) {
+			this(leftCount, rightCount, leftEndpoints, leftShared, rightShared, rightEndpoints,
+					scoped ? new long[] { 42L } : null, false, null, false);
+		}
+
+		Fixture(long leftCount, long rightCount, long leftEndpoints, long leftShared, long rightShared,
+				long rightEndpoints, long[] leftContexts, boolean leftNamed, long[] rightContexts, boolean rightNamed) {
+			when(source.hasCanonicalIds()).thenReturn(true);
+			when(source.exactPredicateCount(20L)).thenReturn(OptionalLong.of(leftCount));
+			when(source.exactPredicateCount(21L)).thenReturn(OptionalLong.of(rightCount));
+			when(source.adjacencyKeyDomainCardinality(20L, true)).thenReturn(OptionalLong.of(leftEndpoints));
+			when(source.adjacencyKeyDomainCardinality(20L, false)).thenReturn(OptionalLong.of(leftShared));
+			when(source.adjacencyKeyDomainCardinality(21L, true)).thenReturn(OptionalLong.of(rightShared));
+			when(source.adjacencyKeyDomainCardinality(21L, false)).thenReturn(OptionalLong.of(rightEndpoints));
+			layout = new NativeSlotLayout(Map.of("a", 0, "j", 1, "b", 2), null);
+			layout.freeze(List.of("a", "j", "b"));
+			PatternPlan left = new PatternPlan(Term.slot(0), Term.constant(20L), Term.slot(1), Term.unbound(),
+					leftContexts == null ? ContextConstraint.UNRESTRICTED : new ContextConstraint(leftContexts),
+					leftNamed, leftCount);
+			PatternPlan right = new PatternPlan(Term.slot(1), Term.constant(21L), Term.slot(2), Term.unbound(),
+					rightContexts == null ? ContextConstraint.UNRESTRICTED : new ContextConstraint(rightContexts),
+					rightNamed, rightCount);
+			aggregates = new AggregateSpec[] { AggregateSpec.star("count", new int[] { 0, 1, 2 }) };
+			input = new JoinPlan(left, right);
+			plan = LmdbSparseJoinAggregatePlan.tryCreate(input, new int[] { 0, 2 }, aggregates, null);
+			assertNotNull(plan);
+			row = new RowState(source, layout, EmptyBindingSet.getInstance());
+			iteration = new NativeGroupIteration(source, input, layout, new int[] { 0, 2 }, aggregates, false,
+					EmptyBindingSet.getInstance(), null, null, false, null);
+			assertTrue(iteration.initialize(row));
+		}
+
+		@Override
+		public void close() {
+			iteration.close();
+			row.closeDecodedInputs();
+			row.memoryScope.close();
+		}
+	}
