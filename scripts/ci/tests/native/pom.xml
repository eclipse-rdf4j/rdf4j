<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.eclipse.rdf4j</groupId>
		<artifactId>rdf4j-pr-verify-partition-fixtures</artifactId>
		<version>@RDF4J_VERSION@</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>rdf4j-pr-verify-partition-native-fixture</artifactId>
	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<properties>
		<nativerdf.surefire.groups></nativerdf.surefire.groups>
		<nativerdf.surefire.excludedGroups></nativerdf.surefire.excludedGroups>
		<nativerdf.surefire.includeTags></nativerdf.surefire.includeTags>
		<nativerdf.surefire.excludeTags></nativerdf.surefire.excludeTags>
	</properties>
	<profiles>
		<profile>
			<id>slowTestsOnly</id>
			<properties>
				<nativerdf.surefire.groups>slow</nativerdf.surefire.groups>
				<nativerdf.surefire.includeTags>slow</nativerdf.surefire.includeTags>
			</properties>
		</profile>
		<profile>
			<id>skipSlowTests</id>
			<properties>
				<nativerdf.surefire.excludedGroups>slow</nativerdf.surefire.excludedGroups>
				<nativerdf.surefire.excludeTags>slow</nativerdf.surefire.excludeTags>
			</properties>
		</profile>
	</profiles>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<groups>${nativerdf.surefire.groups}</groups>
					<excludedGroups>${nativerdf.surefire.excludedGroups}</excludedGroups>
					<properties>
						<includeTags>${nativerdf.surefire.includeTags}</includeTags>
						<excludeTags>${nativerdf.surefire.excludeTags}</excludeTags>
					</properties>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<groups>${nativerdf.surefire.groups}</groups>
					<excludedGroups>${nativerdf.surefire.excludedGroups}</excludedGroups>
					<properties>
						<includeTags>${nativerdf.surefire.includeTags}</includeTags>
						<excludeTags>${nativerdf.surefire.excludeTags}</excludeTags>
					</properties>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
