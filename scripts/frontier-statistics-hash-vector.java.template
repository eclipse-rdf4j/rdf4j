			valueHash = valueHash.lanewise(VectorOperators.XOR, valueHash.lanewise(VectorOperators.LSHR, 27));
			valueHash = valueHash.mul(MIX_MULTIPLIER_2);
			valueHash = valueHash.lanewise(VectorOperators.XOR, valueHash.lanewise(VectorOperators.LSHR, 31));
			LongVector deltaHash = valueHash.lanewise(VectorOperators.XOR, OMNI_DELTA_SEED);
			deltaHash = deltaHash.lanewise(VectorOperators.XOR, deltaHash.lanewise(VectorOperators.LSHR, 30));
			deltaHash = deltaHash.mul(MIX_MULTIPLIER_1);
			deltaHash = deltaHash.lanewise(VectorOperators.XOR, deltaHash.lanewise(VectorOperators.LSHR, 27));
			deltaHash = deltaHash.mul(MIX_MULTIPLIER_2);
			deltaHash = deltaHash.lanewise(VectorOperators.XOR, deltaHash.lanewise(VectorOperators.LSHR, 31));
			IntVector position = (IntVector) valueHash.convertShape(VectorOperators.L2I, INT_SPECIES, 0);
			IntVector delta = ((IntVector) deltaHash.convertShape(VectorOperators.L2I, INT_SPECIES, 0)).or(1);
			position.and(widthMask).intoArray(destination, destinationOffset + 0 * destinationStride + i);
			position.add(delta).and(widthMask).intoArray(destination, destinationOffset + 1 * destinationStride + i);
			position.add(delta.mul(2))
					.and(widthMask)
					.intoArray(destination, destinationOffset + 2 * destinationStride + i);
			position.add(delta.mul(3))
					.and(widthMask)
					.intoArray(destination, destinationOffset + 3 * destinationStride + i);
			position.add(delta.mul(4))
					.and(widthMask)
					.intoArray(destination, destinationOffset + 4 * destinationStride + i);
			position.add(delta.mul(5))
					.and(widthMask)
					.intoArray(destination, destinationOffset + 5 * destinationStride + i);
			position.add(delta.mul(6))
					.and(widthMask)
					.intoArray(destination, destinationOffset + 6 * destinationStride + i);
			position.add(delta.mul(7))
					.and(widthMask)
					.intoArray(destination, destinationOffset + 7 * destinationStride + i);
			position.add(delta.mul(8))
					.and(widthMask)
					.intoArray(destination, destinationOffset + 8 * destinationStride + i);
			position.add(delta.mul(9))
					.and(widthMask)
					.intoArray(destination, destinationOffset + 9 * destinationStride + i);
			position.add(delta.mul(10))
					.and(widthMask)
					.intoArray(destination, destinationOffset + 10 * destinationStride + i);
			position.add(delta.mul(11))
					.and(widthMask)
					.intoArray(destination, destinationOffset + 11 * destinationStride + i);
			position.add(delta.mul(12))
					.and(widthMask)
					.intoArray(destination, destinationOffset + 12 * destinationStride + i);
			position.add(delta.mul(13))
					.and(widthMask)
					.intoArray(destination, destinationOffset + 13 * destinationStride + i);
			position.add(delta.mul(14))
					.and(widthMask)
					.intoArray(destination, destinationOffset + 14 * destinationStride + i);
			position.add(delta.mul(15))
					.and(widthMask)
					.intoArray(destination, destinationOffset + 15 * destinationStride + i);
		}
		for (; i < count; i++) {
			long sequence = FrontierStatisticsHash.omniBucketSequence(lane, component, values[sourceOffset + i]);
			destination[destinationOffset + 0 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 0, widthMask);
			destination[destinationOffset + 1 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 1, widthMask);
			destination[destinationOffset + 2 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 2, widthMask);
			destination[destinationOffset + 3 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 3, widthMask);
			destination[destinationOffset + 4 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 4, widthMask);
			destination[destinationOffset + 5 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 5, widthMask);
			destination[destinationOffset + 6 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 6, widthMask);
			destination[destinationOffset + 7 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 7, widthMask);
			destination[destinationOffset + 8 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 8, widthMask);
			destination[destinationOffset + 9 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 9, widthMask);
			destination[destinationOffset + 10 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 10, widthMask);
			destination[destinationOffset + 11 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 11, widthMask);
			destination[destinationOffset + 12 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 12, widthMask);
			destination[destinationOffset + 13 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 13, widthMask);
			destination[destinationOffset + 14 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 14, widthMask);
			destination[destinationOffset + 15 * destinationStride + i] = FrontierStatisticsHash
					.omniBucketFromSequence(sequence, 15, widthMask);
		}
	}

	static void buckets(int row, int plane, int mask,
			long[] keys, int sourceOffset, int count, int widthMask,
			int[] destination, int destinationOffset) {
		long seed = BUCKET_ROW_STEP * (row + 1L)
				^ BUCKET_MASK_STEP * (mask + 1L)
				^ BUCKET_PLANE_STEP * (plane + 1L);
		int upper = LONG_SPECIES.loopBound(count);
		int i = 0;
		for (; i < upper; i += VECTOR_LENGTH) {
			LongVector hash = LongVector.fromArray(LONG_SPECIES, keys, sourceOffset + i)
					.lanewise(VectorOperators.XOR, seed);
			hash = hash.lanewise(VectorOperators.XOR, hash.lanewise(VectorOperators.LSHR, 30));
			hash = hash.mul(MIX_MULTIPLIER_1);
			hash = hash.lanewise(VectorOperators.XOR, hash.lanewise(VectorOperators.LSHR, 27));
			hash = hash.mul(MIX_MULTIPLIER_2);
			hash = hash.lanewise(VectorOperators.XOR, hash.lanewise(VectorOperators.LSHR, 31));
			IntVector result = (IntVector) hash.convertShape(VectorOperators.L2I, INT_SPECIES, 0);
			result.and(widthMask).intoArray(destination, destinationOffset + i);
		}
		for (; i < count; i++) {
			destination[destinationOffset + i] = FrontierStatisticsHash.bucket(
					keys[sourceOffset + i], row, plane, mask, widthMask);
		}
	}

	static void joinBuckets(int lane, long[] values, int sourceOffset, int count, int widthMask, int[] destination,
			int destinationOffset) {
		long seed = JOIN_BUCKET_LANE_STEP * (lane + 1L);
		int upper = LONG_SPECIES.loopBound(count);
		int i = 0;
		for (; i < upper; i += VECTOR_LENGTH) {
			LongVector hash = LongVector.fromArray(LONG_SPECIES, values, sourceOffset + i)
					.lanewise(VectorOperators.XOR, seed);
			hash = hash.lanewise(VectorOperators.XOR, hash.lanewise(VectorOperators.LSHR, 30));
			hash = hash.mul(MIX_MULTIPLIER_1);
			hash = hash.lanewise(VectorOperators.XOR, hash.lanewise(VectorOperators.LSHR, 27));
			hash = hash.mul(MIX_MULTIPLIER_2);
			hash = hash.lanewise(VectorOperators.XOR, hash.lanewise(VectorOperators.LSHR, 31));
			IntVector result = (IntVector) hash.convertShape(VectorOperators.L2I, INT_SPECIES, 0);
			result = result.and(widthMask);
			result.intoArray(destination, destinationOffset + i);
		}
		for (; i < count; i++) {
			destination[destinationOffset + i] = FrontierStatisticsHash.joinBucket(lane, values[sourceOffset + i],
					widthMask);
		}
	}

	static void joinSigns(int lane, long[] values, int sourceOffset, int count, long[] destination,
			int destinationOffset) {
		long seed = JOIN_SIGN_LANE_STEP * (lane + 1L);
		int upper = LONG_SPECIES.loopBound(count);
		int i = 0;
		for (; i < upper; i += VECTOR_LENGTH) {
			LongVector hash = LongVector.fromArray(LONG_SPECIES, values, sourceOffset + i)
					.lanewise(VectorOperators.XOR, seed);
			hash = hash.lanewise(VectorOperators.XOR, hash.lanewise(VectorOperators.LSHR, 30));
			hash = hash.mul(MIX_MULTIPLIER_1);
			hash = hash.lanewise(VectorOperators.XOR, hash.lanewise(VectorOperators.LSHR, 27));
			hash = hash.mul(MIX_MULTIPLIER_2);
			hash = hash.lanewise(VectorOperators.ASHR, 63).or(1L);
			hash.intoArray(destination, destinationOffset + i);
		}
		for (; i < count; i++) {
			destination[destinationOffset + i] = FrontierStatisticsHash.joinSign(lane, values[sourceOffset + i]);
		}
	}

	static void deltaSigns(int lane, int plane, int mask, long[] keys, int sourceOffset, int count, long[] destination,
			int destinationOffset) {
		long seed = DELTA_SIGN_LANE_STEP * (lane + 1L) ^ DELTA_SIGN_BASE
				^ DELTA_SIGN_PLANE_STEP * (plane + 1L)
				^ DELTA_SIGN_MASK_STEP * (mask + 1L);
		int upper = LONG_SPECIES.loopBound(count);
		int i = 0;
		for (; i < upper; i += VECTOR_LENGTH) {
			LongVector hash = LongVector.fromArray(LONG_SPECIES, keys, sourceOffset + i)
					.lanewise(VectorOperators.XOR, seed);
			hash = hash.lanewise(VectorOperators.XOR, hash.lanewise(VectorOperators.LSHR, 30));
			hash = hash.mul(MIX_MULTIPLIER_1);
			hash = hash.lanewise(VectorOperators.XOR, hash.lanewise(VectorOperators.LSHR, 27));
			hash = hash.mul(MIX_MULTIPLIER_2);
			hash = hash.lanewise(VectorOperators.ASHR, 63).or(1L);
			hash.intoArray(destination, destinationOffset + i);
		}
		for (; i < count; i++) {
			destination[destinationOffset + i] = FrontierStatisticsHash.deltaSign(keys[sourceOffset + i], lane, plane,
					mask);
		}
	}
