	static void centerEdgePriorities4FromRowPriorities(int component,
			long[] rowPriorities, int rowOffset, int count,
			long[] destination, int destinationOffset, int destinationStride) {
		long componentSeed = CENTER_EDGE_COMPONENT_STEP * (component + 1L);
		int upper = LONG_SPECIES.loopBound(count);
		int i = 0;
		for (; i < upper; i += VECTOR_LENGTH) {
			LongVector rowPriority = LongVector.fromArray(LONG_SPECIES, rowPriorities, rowOffset + i);
			LongVector lane0 = rowPriority.lanewise(VectorOperators.XOR, (1L * CENTER_EDGE_LANE_STEP) ^ componentSeed);
			LongVector lane1 = rowPriority.lanewise(VectorOperators.XOR, (2L * CENTER_EDGE_LANE_STEP) ^ componentSeed);
			LongVector lane2 = rowPriority.lanewise(VectorOperators.XOR, (3L * CENTER_EDGE_LANE_STEP) ^ componentSeed);
			LongVector lane3 = rowPriority.lanewise(VectorOperators.XOR, (4L * CENTER_EDGE_LANE_STEP) ^ componentSeed);
			lane0 = lane0.lanewise(VectorOperators.XOR, lane0.lanewise(VectorOperators.LSHR, 30));
			lane1 = lane1.lanewise(VectorOperators.XOR, lane1.lanewise(VectorOperators.LSHR, 30));
			lane2 = lane2.lanewise(VectorOperators.XOR, lane2.lanewise(VectorOperators.LSHR, 30));
			lane3 = lane3.lanewise(VectorOperators.XOR, lane3.lanewise(VectorOperators.LSHR, 30));
			lane0 = lane0.mul(MIX_MULTIPLIER_1);
			lane1 = lane1.mul(MIX_MULTIPLIER_1);
