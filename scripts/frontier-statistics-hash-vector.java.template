	static void omniBucketSequences(int lane, int component,
			long[] values, int sourceOffset, int count,
			long[] destination, int destinationOffset) {
		long seed = COMPONENT_SEEDS[component] ^ OMNI_VALUE_LANE_STEP * (lane + 1L);
		int upper = LONG_SPECIES.loopBound(count);
		int i = 0;
		for (; i < upper; i += VECTOR_LENGTH) {
			LongVector valueHash = LongVector.fromArray(LONG_SPECIES, values, sourceOffset + i)
					.lanewise(VectorOperators.XOR, seed);
			valueHash = valueHash.lanewise(VectorOperators.XOR, valueHash.lanewise(VectorOperators.LSHR, 30));
			valueHash = valueHash.mul(MIX_MULTIPLIER_1);
			valueHash = valueHash.lanewise(VectorOperators.XOR, valueHash.lanewise(VectorOperators.LSHR, 27));
			valueHash = valueHash.mul(MIX_MULTIPLIER_2);
			valueHash = valueHash.lanewise(VectorOperators.XOR, valueHash.lanewise(VectorOperators.LSHR, 31));
			LongVector delta = valueHash.lanewise(VectorOperators.XOR, OMNI_DELTA_SEED);
			delta = delta.lanewise(VectorOperators.XOR, delta.lanewise(VectorOperators.LSHR, 30));
			delta = delta.mul(MIX_MULTIPLIER_1);
			delta = delta.lanewise(VectorOperators.XOR, delta.lanewise(VectorOperators.LSHR, 27));
			delta = delta.mul(MIX_MULTIPLIER_2);
			delta = delta.lanewise(VectorOperators.XOR, delta.lanewise(VectorOperators.LSHR, 31));
			LongVector sequence = delta.or(1L)
					.lanewise(VectorOperators.LSHL, 32)
					.or(valueHash.and(0xffff_ffffL));
			sequence.intoArray(destination, destinationOffset + i);
		}
		for (; i < count; i++) {
			destination[destinationOffset + i] = FrontierStatisticsHash.omniBucketSequence(
					lane, component, values[sourceOffset + i]);
		}
	}

	static void omniBuckets4(int lane, int component,
