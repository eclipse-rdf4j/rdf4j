			lane3 = lane3.mul(MIX_MULTIPLIER_1);
			lane0 = lane0.lanewise(VectorOperators.XOR, lane0.lanewise(VectorOperators.LSHR, 27));
			lane1 = lane1.lanewise(VectorOperators.XOR, lane1.lanewise(VectorOperators.LSHR, 27));
			lane2 = lane2.lanewise(VectorOperators.XOR, lane2.lanewise(VectorOperators.LSHR, 27));
			lane3 = lane3.lanewise(VectorOperators.XOR, lane3.lanewise(VectorOperators.LSHR, 27));
			lane0 = lane0.mul(MIX_MULTIPLIER_2);
			lane1 = lane1.mul(MIX_MULTIPLIER_2);
			lane2 = lane2.mul(MIX_MULTIPLIER_2);
			lane3 = lane3.mul(MIX_MULTIPLIER_2);
