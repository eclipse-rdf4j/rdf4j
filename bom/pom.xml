<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.eclipse.rdf4j</groupId>
		<artifactId>rdf4j</artifactId>
		<version>6.2.0-SNAPSHOT</version>
	</parent>
	<artifactId>rdf4j-bom</artifactId>
	<packaging>pom</packaging>
	<name>RDF4J: BOM</name>
	<description>RDF4J Bill of Materials (BOM)</description>
	<!--
		The published BOM is generated by the bom-builder3 plugin from the modules of the reactor and replaces this
		POM on install/deploy. Reactor modules are included automatically unless they are excluded below.

		The dependencies declared here are not dependencies of the BOM itself. They are additional, differently typed
		RDF4J artifacts that are copied into the dependencyManagement of the generated BOM.
	-->
	<dependencies>
		<!-- rdf4j-runtime-osgi has packaging "bundle"; also manage it under the default type "jar" -->
		<dependency>
			<groupId>org.eclipse.rdf4j</groupId>
			<artifactId>rdf4j-runtime-osgi</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>eu.maveniverse.maven.plugins</groupId>
				<artifactId>bom-builder3</artifactId>
				<version>1.3.4</version>
				<executions>
					<execution>
						<id>build-bom</id>
						<goals>
							<goal>build-bom</goal>
						</goals>
						<configuration>
							<attach>true</attach>
							<bomName>${project.name}</bomName>
							<bomDescription>${project.description}</bomDescription>
							<!-- include the umbrella POMs rdf4j-client, rdf4j-storage and rdf4j-runtime -->
							<includePoms>true</includePoms>
							<directDependencies>CURRENT_PROJECT</directDependencies>
							<dependencyExclusions>
								<!-- the BOM itself and build-internal modules -->
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-bom</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-assembly</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-assembly-descriptors</artifactId>
								</exclusion>
								<!-- parent / aggregator POMs -->
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-core</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-common</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-collection-factory</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-http</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-queryalgebra</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-queryparser</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-queryresultio</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-repository</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-rio</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-sail</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-tools</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-spring-components</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-testsuites</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-compliance</artifactId>
								</exclusion>
								<!-- benchmarks, examples and demos -->
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-benchmark</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-benchmark-common</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-examples</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-spring-demo</artifactId>
								</exclusion>
								<!-- compliance tests -->
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-elasticsearch-compliance</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-geosparql-compliance</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-lucene-compliance</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-model-compliance</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-repository-compliance</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-rio-compliance</artifactId>
								</exclusion>
								<exclusion>
									<groupId>org.eclipse.rdf4j</groupId>
									<artifactId>rdf4j-sparql-compliance</artifactId>
								</exclusion>
							</dependencyExclusions>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
