// Some portions generated by Claude
package org.eclipse.rdf4j.sail.lmdb.evaluation;

/**
 * Test-scope bridge to the exact-count counter. {@link LmdbNativeAggregateCompiler} is package-private, so tests living
 * in {@code org.eclipse.rdf4j.sail.lmdb} — where the store internals they also need are package-private — cannot read
 * it directly. This is the counter that tells "the count was read from the store's cardinalities" apart from "the count
 * was correct, by enumerating every row", which a result value alone cannot distinguish.
 */
public final class ExactCountTestAccess {

	private ExactCountTestAccess() {
	}

	/** Ungrouped COUNTs answered from stored cardinalities. Process-wide, not per store. */
	public static long exactCounts() {
		return LmdbNativeAggregateCompiler.EXACT_COUNTS.get();
	}
}
