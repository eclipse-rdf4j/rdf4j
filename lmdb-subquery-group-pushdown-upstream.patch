+import org.eclipse.rdf4j.query.algebra.ExtensionElem;
+import org.eclipse.rdf4j.query.algebra.Group;
+import org.eclipse.rdf4j.query.algebra.GroupElem;
+import org.eclipse.rdf4j.query.algebra.Join;
+import org.eclipse.rdf4j.query.algebra.Projection;
+import org.eclipse.rdf4j.query.algebra.ProjectionElem;
+import org.eclipse.rdf4j.query.algebra.ProjectionElemList;
+import org.eclipse.rdf4j.query.algebra.QueryModelNode;
+import org.eclipse.rdf4j.query.algebra.TupleExpr;
+import org.eclipse.rdf4j.query.algebra.evaluation.QueryOptimizer;
+import org.eclipse.rdf4j.query.algebra.helpers.AbstractSimpleQueryModelVisitor;
+import org.eclipse.rdf4j.query.algebra.helpers.TupleExprs;
+import org.eclipse.rdf4j.query.algebra.helpers.collectors.VarNameCollector;
+
+/**
+ * Moves a GROUP BY below a join with a subquery that has exactly one row per join key.
+ *
+ * <p>
+ * A query of the shape {@code Group(Join(Sub, Rest), K, A)}, where {@code Sub} is a subquery grouped by one variable
+ * {@code c1}, joins every row of {@code Rest} with at most one row of {@code Sub}. Grouping {@code Rest} by the keys
+ * that do not come from {@code Sub} and joining the (few) groups with {@code Sub} afterwards therefore yields the same
+ * rows, and exposes the inner group as a plain aggregate over {@code Rest} to the native planner (for example the type
+ * matrix). The rewrite is
+ * </p>
+ *
+ * <pre>
+ * Group(Join(Sub, Rest), K, A)  ==>  Join(Sub, Projection[subquery](Extension[A](Group(Rest, K', A))))
+ * </pre>
+ *
+ * <p>
+ * It applies only when all of the following hold, otherwise the query is left alone:
+ * </p>
+ * <ol>
+ * <li>{@code Sub} is a plain subquery projection (no renames, no graph or projection context) over optional extensions
+ * over a Group whose only grouping variable is {@code c1}.</li>
+ * <li>{@code Sub} and {@code Rest} share exactly the variable {@code c1}; no other variable of {@code Sub} is mentioned
+ * anywhere in {@code Rest}.</li>
+ * <li>{@code c1} is assured by both {@code Sub} and {@code Rest}.</li>
+ * <li>{@code c1} and every other variable of {@code Sub} are grouping keys of the outer group.</li>
+ * <li>No outer aggregate reads a variable of {@code Sub} other than {@code c1}.</li>
+ * <li>Only inner joins connect the operands: the group's argument is a tree of {@link Join}s whose operands include
+ * {@code Sub}.</li>
+ * </ol>
+ *
+ * <p>
+ * The SPARQL parser represents each aggregate twice, as a {@link GroupElem} and as an {@link ExtensionElem} above the
+ * group. The aggregate extension elements move with the group so the new subquery has the shape of a hand-written one;
+ * other extension elements stay where they are. The optimizer keeps no state between calls.
+ * </p>
+ */
+@Experimental
+@InternalUseOnly
+public final class LmdbSubqueryGroupPushdownOptimizer implements QueryOptimizer {
+
+	@Override
+	public void optimize(TupleExpr tupleExpr, Dataset dataset, BindingSet bindings) {
+		List<Group> groups = new ArrayList<>();
+		tupleExpr.visit(new AbstractSimpleQueryModelVisitor<RuntimeException>() {
+			@Override
+			public void meet(Group node) {
+				groups.add(node);
+				super.meet(node);
+			}
+		});
+		for (Group group : groups) {
+			rewrite(group);
+		}
+	}
+
+	private static void rewrite(Group group) {
+		if (!(group.getArg() instanceof Join) || group.getGroupElements().isEmpty()) {
+			return;
+		}
+		List<TupleExpr> operands = new ArrayList<>();
+		collectOperands(group.getArg(), operands);
+
+		Projection sub = null;
+		String joinKey = null;
+		for (TupleExpr operand : operands) {
+			String key = oneRowPerKeyVariable(operand);
+			if (key != null) {
+				if (sub != null) {
+					return; // more than one candidate, do not guess
+				}
+				sub = (Projection) operand;
+				joinKey = key;
+			}
+		}
+		if (sub == null) {
+			return;
+		}
+
+		List<TupleExpr> rest = new ArrayList<>(operands);
+		rest.remove(sub);
+		if (rest.isEmpty()) {
+			return;
+		}
+
+		Set<String> subNames = sub.getBindingNames();
+		Set<String> subOther = new LinkedHashSet<>(subNames);
+		subOther.remove(joinKey);
+
+		Set<String> restNames = new HashSet<>();
+		Set<String> restAssured = new HashSet<>();
+		Set<String> restMentioned = new HashSet<>();
+		for (TupleExpr operand : rest) {
+			restNames.addAll(operand.getBindingNames());
+			restAssured.addAll(operand.getAssuredBindingNames());
+			restMentioned.addAll(VarNameCollector.process(operand));
+		}
+
+		// rule 2: the only shared variable is the join key, and Rest never mentions another Sub variable
+		Set<String> shared = new HashSet<>(subNames);
+		shared.retainAll(restNames);
+		if (shared.size() != 1 || !shared.contains(joinKey)) {
+			return;
+		}
+		for (String name : subOther) {
+			if (restMentioned.contains(name)) {
+				return;
+			}
+		}
+		// rule 3
+		if (!sub.getAssuredBindingNames().contains(joinKey) || !restAssured.contains(joinKey)) {
+			return;
+		}
+		// rule 4
+		Set<String> keys = group.getGroupBindingNames();
+		if (!keys.contains(joinKey) || !keys.containsAll(subOther)) {
+			return;
+		}
+		List<String> pushedKeys = new ArrayList<>();
+		for (String key : keys) {
+			if (!subOther.contains(key)) {
+				pushedKeys.add(key);
+			}
+		}
+		// rule 5, plus: aggregate aliases must not collide with anything visible
+		List<GroupElem> groupElements = new ArrayList<>(group.getGroupElements());
+		for (GroupElem groupElement : groupElements) {
+			if (subNames.contains(groupElement.getName()) || keys.contains(groupElement.getName())
+					|| restNames.contains(groupElement.getName())) {
+				return;
+			}
+			for (String name : VarNameCollector.process(groupElement.getOperator())) {
+				if (subOther.contains(name)) {
+					return;
+				}
+			}
+		}
+
+		// the aggregate ExtensionElems that the parser put above the group
+		List<Extension> chain = new ArrayList<>();
+		TupleExpr top = group;
+		while (top.getParentNode() instanceof Extension extension && extension.getArg() == top) {
+			chain.add(extension);
+			top = extension;
+		}
+		List<ExtensionElem> moved = new ArrayList<>();
+		for (GroupElem groupElement : groupElements) {
+			ExtensionElem match = null;
+			for (Extension extension : chain) {
+				for (ExtensionElem element : extension.getElements()) {
+					if (element.getName().equals(groupElement.getName())
+							&& element.getExpr() instanceof AggregateOperator
+							&& element.getExpr().equals(groupElement.getOperator())) {
+						match = element;
+					}
+				}
+			}
+			if (match == null) {
+				return;
+			}
+			moved.add(match);
+		}
+
+		// all checks passed; from here on the tree is modified
+		TupleExpr restExpr = rest.get(0);
+		for (int i = 1; i < rest.size(); i++) {
+			restExpr = new Join(restExpr, rest.get(i));
+		}
+		Group pushed = new Group(restExpr, pushedKeys);
+		for (GroupElem groupElement : groupElements) {
+			pushed.addGroupElement(groupElement);
+		}
+		Extension pushedExtension = new Extension(pushed);
+		for (ExtensionElem element : moved) {
+			pushedExtension.addElement(element);
+		}
+		ProjectionElemList projected = new ProjectionElemList();
+		for (String key : pushedKeys) {
+			projected.addElement(new ProjectionElem(key));
+		}
+		for (GroupElem groupElement : groupElements) {
+			ProjectionElem aggregate = new ProjectionElem(groupElement.getName());
+			aggregate.setAggregateOperatorInExpression(true);
+			projected.addElement(aggregate);
+		}
+		Projection pushedSubquery = new Projection(pushedExtension, projected, true);
+
+		TupleExpr replacement = new Join(sub, pushedSubquery);
+		for (Extension extension : chain) {
+			List<ExtensionElem> remaining = new ArrayList<>(extension.getElements());
+			remaining.removeAll(moved);
+			if (!remaining.isEmpty()) {
+				extension.setElements(remaining);
+				extension.setArg(replacement);
+				replacement = extension;
+			}
+		}
+		if (replacement != top) {
+			top.replaceWith(replacement);
+		}
+	}
+
+	private static void collectOperands(TupleExpr tupleExpr, List<TupleExpr> operands) {
+		if (tupleExpr instanceof Join join && !join.isMergeJoin() && !TupleExprs.isVariableScopeChange(join)) {
+			collectOperands(join.getLeftArg(), operands);
+			collectOperands(join.getRightArg(), operands);
+		} else {
+			operands.add(tupleExpr);
+		}
+	}
+
+	/**
+	 * @return the single grouping variable when {@code operand} is a plain subquery that has at most one row per value
+	 *         of that variable, else {@code null}.
+	 */
+	private static String oneRowPerKeyVariable(TupleExpr operand) {
+		if (!(operand instanceof Projection projection) || !projection.isSubquery()
+				|| projection.getInheritedGraphParameter() != null || projection.getProjectionContext() != null) {
+			return null;
+		}
+		for (ProjectionElem element : projection.getProjectionElemList().getElements()) {
+			if (element.getProjectionAlias().filter(alias -> !alias.equals(element.getName())).isPresent()) {
+				return null;
+			}
+		}
+		Set<String> extended = new HashSet<>();
+		TupleExpr current = projection.getArg();
+		while (current instanceof Extension extension) {
+			for (ExtensionElem element : extension.getElements()) {
+				extended.add(element.getName());
+			}
+			current = extension.getArg();
+		}
+		if (!(current instanceof Group group) || group.getGroupBindingNames().size() != 1) {
+			return null;
+		}
+		String key = group.getGroupBindingNames().iterator().next();
+		if (extended.contains(key) || group.getAggregateBindingNames().contains(key)) {
+			return null;
+		}
+		if (!projection.getBindingNames().contains(key) || !projection.getAssuredBindingNames().contains(key)) {
+			return null;
+		}
+		return key;
+	}
+}
