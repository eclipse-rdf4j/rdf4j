prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix geo: <http://www.opengis.net/ont/geosparql#>
prefix geof: <http://www.opengis.net/def/function/geosparql/>

select distinct
	(geof:sfEquals(?hull, "LINESTRING (48.8582 2.2945, 48.8738 2.295)"^^geo:wktLiteral) as ?matchesLine)
	(str(?hull) = "POINT (48.8582 2.2945)" as ?matchesFirstPoint)
	(str(?hull) = "POINT (48.8738 2.295)" as ?matchesSecondPoint)
	(datatype(?hull) as ?datatype)
	(geof:getSRID(?hull) as ?srid)
where {
	?x geo:asWKT ?xGeom.
	?y geo:asWKT ?yGeom.
	bind(geof:convexHull(geof:union(?xGeom, ?yGeom)) as ?hull)
}
