<?xml version="1.0"?>
<sparql
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:xs="http://www.w3.org/2001/XMLSchema#"
    xmlns="http://www.w3.org/2005/sparql-results#" >
  <head>
    <variable name="matchesLine"/>
    <variable name="matchesFirstPoint"/>
    <variable name="matchesSecondPoint"/>
    <variable name="datatype"/>
    <variable name="srid"/>
  </head>
  <results>
    <result>
      <binding name="matchesLine">
        <literal datatype="http://www.w3.org/2001/XMLSchema#boolean">true</literal>
      </binding>
      <binding name="matchesFirstPoint">
        <literal datatype="http://www.w3.org/2001/XMLSchema#boolean">false</literal>
      </binding>
      <binding name="matchesSecondPoint">
        <literal datatype="http://www.w3.org/2001/XMLSchema#boolean">false</literal>
      </binding>
      <binding name="datatype">
        <uri>http://www.opengis.net/ont/geosparql#wktLiteral</uri>
      </binding>
      <binding name="srid">
        <literal datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.opengis.net/def/crs/OGC/1.3/CRS84</literal>
      </binding>
    </result>
    <result>
      <binding name="matchesLine">
        <literal datatype="http://www.w3.org/2001/XMLSchema#boolean">false</literal>
      </binding>
      <binding name="matchesFirstPoint">
        <literal datatype="http://www.w3.org/2001/XMLSchema#boolean">true</literal>
      </binding>
      <binding name="matchesSecondPoint">
        <literal datatype="http://www.w3.org/2001/XMLSchema#boolean">false</literal>
      </binding>
      <binding name="datatype">
        <uri>http://www.opengis.net/ont/geosparql#wktLiteral</uri>
      </binding>
      <binding name="srid">
        <literal datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.opengis.net/def/crs/OGC/1.3/CRS84</literal>
      </binding>
    </result>
    <result>
      <binding name="matchesLine">
        <literal datatype="http://www.w3.org/2001/XMLSchema#boolean">false</literal>
      </binding>
      <binding name="matchesFirstPoint">
        <literal datatype="http://www.w3.org/2001/XMLSchema#boolean">false</literal>
      </binding>
      <binding name="matchesSecondPoint">
        <literal datatype="http://www.w3.org/2001/XMLSchema#boolean">true</literal>
      </binding>
      <binding name="datatype">
        <uri>http://www.opengis.net/ont/geosparql#wktLiteral</uri>
      </binding>
      <binding name="srid">
        <literal datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.opengis.net/def/crs/OGC/1.3/CRS84</literal>
      </binding>
    </result>
  </results>
</sparql>
